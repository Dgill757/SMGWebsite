# Names only. Never commit real values. Set these in Vercel > smg-website > Settings > Environment Variables.

# GoHighLevel Private Integration Token (location level, scopes: contacts.write and contacts.readonly only)
GHL_PIT=

# GoHighLevel location (sub-account) id for Summit Voice AI
GHL_LOCATION_ID=

# Optional: extra hosts allowed to call /api/lead, comma separated (for example a staging domain).
# Same-origin requests are always allowed.
ALLOWED_ORIGINS=
